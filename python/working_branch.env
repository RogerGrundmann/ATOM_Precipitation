# working_branch.env -- the energy-conserving WORKING BRANCH (user, 2026-09-29). Source it before a run:
#   . ./working_branch.env && env OMP_NUM_THREADS=8 ../cli/atm config_X.xml
# These are environment settings, NOT compiled-in defaults; flipping them to defaults needs its own byte checks.
# Evidence: run_stm.sh (STORM: the kept SatAdj latent heat is physical), run_cvs.sh (CONV-DEAD: cvs_all = this stack).
export ATM_WATER_CLOSURE=1        # budget closure; forces ATM_RK_SCALAR_SYNC=2 (keeps SatAdj condensate AND latent heat)
export ATM_DAMP_Q_VERT=0          # moisture Shapiro filter off (vertical)   -- it drove the 09-24 closure runaway
export ATM_DAMP_Q_HORIZ=0         # moisture Shapiro filter off (meridional) -- ditto
export ATM_DAMP_T_VERT=0          # vertical temperature filter off (qh_on setup)
export ATM_PRECIP_UPWIND=1        # converged rain column
export ATM_SNOW_WINDOW=2          # keep snow on the cold side of -20 C
export ATM_MC_QVD=2               # saturated convective downdraft (was cloud water for vapour)
export ATM_MC_ED_AREA=1           # area-weighted downdraft evaporation
export ATM_MC_ALF1=5.44e-4        # Tiedtke sub-cloud evaporation rate (shipped 0.05, 92x)
export ATM_MC_BASE_SAT=2          # cloud-base seed from the grid's own saturation
export ATM_SEAM_Q_CONSERVE=2      # conserve seam water also next to land (leak 981 -> 1.3 mm/a); added 2026-09-29, seam mode exonerated (sqp pair)
export ATM_RH_STORM=1.15          # moister initial storm-track column (user, 2026-09-30); 1.1 gave 35-65 313 mm/a with shape kept, 1.25 gave 2069 and broke it (run_rhst.sh); 1.15 itself NOT yet run -- RE-JUDGED 2026-10-01 on the corrected branch (rs2: 1.0 -> 35-65 25, 1.15 -> 216, 1.25 -> 859 with r .335/.316/.271, sigma 1.23/1.24/1.43): KEPT at 1.15 (user)
export ATM_SNOW_DEP_FLUX=1        # SNOW-SUBL (user, 2026-10-01): snow sublimation also debits the snow flux; ~5.8e3 mm/a of manufactured vapour removed (sdx_on vs sdx_ctl: precip 546 -> 413, r .263 -> .316, 35-65 632 -> 216)
export ATM_MC_COND_DEBIT=1        # MC-Q-LEAK (user, 2026-10-01): c_u = g_p + e_l, convective rain debited from the vapour; MC_q column = -P_conv exactly; climate null at 600 (sdx_both)
export ATM_MC_Q_NDIM=1            # MC-Q-LEAK remainder (user, 2026-10-01): coeff_MC_q = L/u_0 (was L_atm/(u_0*c_0) = 0.713x); qnd1 probe applied MC_q = -P_conv to 0.01 %; no 600 arm yet (expected climate null)
export ATM_Q_DIFF_FLUX=1          # DIFF-LEAK (user, 2026-10-01): flux-form rho-weighted vertical moisture diffusion; removes +222 mm/a of water the stretched-grid Laplacian created (td4: remainder +206 -> -14.6)
export ATM_MC_T_COEFF=1           # MC-TV (user, 2026-10-01): convective heating applied at L/u_0 (was 0.025x); 0.62 -> 24.9 W/m2 = L*P_conv (tv2)
export ATM_MC_UV_DETRAIN=1        # MC-TV (user, 2026-10-01): updraft v_u/w_u recurrence detrains like q_v_u/s_u; |w_u-w| p50 15.5 -> 0.28 m/s (tv2)
export ATM_MC_VEL_COEFF=1         # MC-TV (user, 2026-10-01): coeff_MC_vel at L/u_0^2 (was 0.025x) -- ONLY with ATM_MC_UV_DETRAIN=1; drag/cor 0.09 where active (tv3)
