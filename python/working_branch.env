# working_branch.env -- the energy-conserving WORKING BRANCH (user, 2026-09-29). Source it before a run:
#   . ./working_branch.env && env OMP_NUM_THREADS=8 ../cli/atm config_X.xml
# These are environment settings, NOT compiled-in defaults; flipping them to defaults needs its own byte checks.
# Evidence: run_stm.sh (STORM: the kept SatAdj latent heat is physical), run_cvs.sh (CONV-DEAD: cvs_all = this stack).
export ATM_WATER_CLOSURE=1        # budget closure; forces ATM_RK_SCALAR_SYNC=2 (keeps SatAdj condensate AND latent heat)
export ATM_DAMP_Q_VERT=0          # moisture Shapiro filter off (vertical)   -- it drove the 09-24 closure runaway
export ATM_DAMP_Q_HORIZ=0         # moisture Shapiro filter off (meridional) -- ditto
export ATM_DAMP_T_VERT=0          # vertical temperature filter off (qh_on setup)
export ATM_PRECIP_UPWIND=1        # converged rain column
export ATM_SNOW_WINDOW=2          # keep snow on the cold side of -20 C
export ATM_MC_QVD=2               # saturated convective downdraft (was cloud water for vapour)
export ATM_MC_ED_AREA=1           # area-weighted downdraft evaporation
export ATM_MC_ALF1=5.44e-4        # Tiedtke sub-cloud evaporation rate (shipped 0.05, 92x)
export ATM_MC_BASE_SAT=2          # cloud-base seed from the grid's own saturation
export ATM_SEAM_Q_CONSERVE=2      # conserve seam water also next to land (leak 981 -> 1.3 mm/a); added 2026-09-29, seam mode exonerated (sqp pair)
export ATM_RH_STORM=1.13          # (1.15 -> 1.13 with the wb63 stack, together with the width below) moister initial storm-track column; history: 1.1 / 1.15 / 1.25 on older branches gave 35-65 313 / 216 / 859-2069 mm/a (run_rhst.sh, rs2) -- the response is a cliff
export ATM_SNOW_DEP_FLUX=1        # SNOW-SUBL (user, 2026-10-01): snow sublimation also debits the snow flux; ~5.8e3 mm/a of manufactured vapour removed (sdx_on vs sdx_ctl: precip 546 -> 413, r .263 -> .316, 35-65 632 -> 216)
export ATM_MC_COND_DEBIT=1        # MC-Q-LEAK (user, 2026-10-01): c_u = g_p + e_l, convective rain debited from the vapour; MC_q column = -P_conv exactly; climate null at 600 (sdx_both)
export ATM_MC_Q_NDIM=1            # MC-Q-LEAK remainder (user, 2026-10-01): coeff_MC_q = L/u_0 (was L_atm/(u_0*c_0) = 0.713x); qnd1 probe applied MC_q = -P_conv to 0.01 %; no 600 arm yet (expected climate null)
export ATM_Q_DIFF_FLUX=1          # DIFF-LEAK (user, 2026-10-01): flux-form rho-weighted vertical moisture diffusion; removes +222 mm/a of water the stretched-grid Laplacian created (td4: remainder +206 -> -14.6)
export ATM_MC_T_COEFF=1           # MC-TV (user, 2026-10-01): convective heating applied at L/u_0 (was 0.025x); 0.62 -> 24.9 W/m2 = L*P_conv (tv2)
export ATM_MC_UV_DETRAIN=1        # MC-TV (user, 2026-10-01): updraft v_u/w_u recurrence detrains like q_v_u/s_u; |w_u-w| p50 15.5 -> 0.28 m/s (tv2)
export ATM_MC_VEL_COEFF=1         # MC-TV (user, 2026-10-01): coeff_MC_vel at L/u_0^2 (was 0.025x) -- ONLY with ATM_MC_UV_DETRAIN=1; drag/cor 0.09 where active (tv3)
export ATM_MC_QC_DETRAIN=1        # MC-TV (user, 2026-10-01): updraft condensate detrains its own q_c_u (was the environment's cloud); qc probe P_conv 311 -> 101 over 40 iters
export ATM_MC_SGZ=1               # parcel condenses (user, 2026-10-01): s = cp*T + g*z; with ATM_MC_ENTR the parcel is supersaturated in 79 % of recurrence cells (pcd1)
export ATM_MC_ENTR=1e-4           # Tiedtke deep entrainment (shipped 0.2/R_cloud = 2e-3); MUST be set with ATM_MC_SGZ
export ATM_MC_ED_ABOVE_BASE=1     # (user, 2026-10-01) e_d only above cloud base; e_p the single sub-cloud term (pcd2: 25.6 % of convective rain survives, was 8.5 %)
# --- wb27 stack (user, 2026-10-04): verified at 600 from scratch (run_wb27.sh): 917.7 mm/a (-6.2 %), r .562, sigma 2.86, bands 3018/295/204/4.5,
# land/ocean 443/1106, land 0-15 1640 (NASA 1653), no cell > 38 mm/d. Supersedes wb14 (864 mm/a, r .458, sigma 3.79). Open: slow drift (+0.7 % over 100-600).
export ATM_MC_ML_PARCEL=1         # mixed-layer (0-500 m) parcel instead of the base parcel
export ATM_MC_T_ADD=0.15          # parcel temperature excess, K (ocean and land unless ATM_MC_T_ADD_LAND is set)
export ATM_MC_Q_ADD=4.5e-4        # parcel humidity excess, kg/kg
export ATM_MC_ML_LCL=1            # cloud base at the ML parcel's own LCL (desert hotspots gone, wb9)
export ATM_RH_LAND=2              # initial land surface RH from descent x continentality; wet end follows ATM_RH_OCEAN in the tropics
export ATM_RH_LAND_QCAP=1         # initial land q <= zonal-mean ocean q at the same height above ground (Horn of Africa hotspot, wb14)
export ATM_RH_OCEAN=0.82          # initial ocean surface RH; 0.80 -> 0.82 with the wb34 stack (fills the rainless quarter of the tropical ocean; needs the mass-flux ceiling below)
export ATM_MC_GATE_BLEND=3        # undiluted parcel, recurrence gate threshold 0.01 (no rain cliff) -- ONLY with ATM_MC_GP_AREA=1 (alone: 4335 mm/a, wb23)
export ATM_MC_GP_AREA=1           # g_p = a_u*K_p*q_c_u (a_u 0.03): in-updraft conversion rate area-weighted to the grid (hotspots 105 -> 27 mm/d, wb24)
export ATM_MC_T_ADD_LAND=2.3      # land parcel temperature excess, K (land 0-15 1641 vs NASA 1653; 2.6 gives 1907, wb25)
# --- wb34 stack (user, 2026-10-04): verified at 600 from scratch (run_wb34.sh): 970.0 mm/a (-0.8 %), r .580, sigma 1.36, bands 2035/516/874/36,
# land/ocean 561/1132, ocean 0-15 1998, ocean 35-65 1043 (NASA 1107), no cell > 24 mm/d, no drift. Closes RAIN-CONV and STORM. Supersedes wb27.
export ATM_MC_MB_SAT_OCEAN=0.05   # (0.045 -> 0.05 with the wb45 stack: lets the warm pool peak, p99 8.3 vs NASA 8.4) cloud-base mass-flux ceiling over ocean, M_b -> M_s*tanh(M_b/M_s): the tropical-ocean rain peak (p99 28.8 -> 7.7 mm/d; NASA 8.4)
export ATM_MC_MB_SAT_LAND=0.035   # (0.045 -> 0.035 with the wb45 stack: lowland tropical land, Amazon 8.6 -> 7.2 mm/d) the ceiling over land (Amazon 16.2 -> 8.2 mm/d at RH_OCEAN 0.82)
export ATM_RH_OCEAN_ML=1500       # extratropical ocean (latitude taper, see ATM_RH_OCEAN_ML_LAT0 / _LAT1 below; 30..40 deg until wb68): initial boundary layer mixed up to 1500 m -- ONLY with the strength below (alone: ocean 35-65 9732 mm/a, wb32)
export ATM_RH_OCEAN_ML_STRENGTH=0.4  # partial mixing: the storm-track rain reaches the sea (ocean 35-65 171 -> 1043; 0.25 gives 486, wb33)
# --- wb45 stack (user, 2026-10-05: "no 1" = accept and adopt): verified at 600 from scratch (run_wb45.sh): 975.4 mm/a (-0.3 %), r .605, sigma 1.26,
# bands 1754/536/1028/220, land/ocean 667/1098, land 0-15 / 15-35 / 35-65 1627 / 319 / 643 (NASA 1653 / 643 / 643), no cell > 19 mm/d, no drift
# (978.2 -> 975.4 over 100-600). Every wb34 and LAND-POLAR criterion met EXCEPT land 15-35 (319 vs > 320) -- accepted by the user.
# Also changed above: ATM_MC_MB_SAT_OCEAN 0.045 -> 0.05, ATM_MC_MB_SAT_LAND 0.045 -> 0.035.
export ATM_RH_SIGMA_LAT=52        # poleward of 52 deg the initial RH profile uses the column's own surface pressure (cold columns stand at ~905 hPa): land 65-90 8 -> 256 (wb35)
export ATM_RH_SIGMA_LAT_OCEAN=1   # ... on ocean columns too: 65-90 band 151 -> 222 (wb35b)
export ATM_RH_LAND_EAST=1.6       # (1.35 -> 1.6 with the wb49 stack, ONLY with the cap below: uncapped, 1.4 already breaks r) trade-wind fetch from an ocean to the east cancels the subtropical descent drying: land 15-35 9 -> 319 at 1.35 uncapped (wb36-38, 42, 44)
export ATM_RH_LAND_EAST_MAX=0.010 # cap the east-fetch land RH at the wet end + 0.010 (the factor 1 - strength*m_east went negative where the fetch is complete): E Australia 6.07 -> 2.70 mm/d (NASA 1.86), wettest cell 18.2 -> 10.5 (wb47, wb49); looser caps raise every east side together (wb48: +0.02 / +0.03 / +0.05 -> E Australia 3.90 / 5.14 / 8.09, land 15-35 276 / 342 / 477)
export ATM_HCRIT_SFC=1            # terrain-following stratiform cloud threshold on land columns below 1000 hPa: E Africa 9.96 -> 2.86 mm/d, land 0-15 2354 -> 1658 (wb40)
export ATM_HCRIT_SFC_LAT=25       # ... full to 25 deg, none from 35 -- MANDATORY (without it land 35-65 628 -> 18, wb39b); 25 removes the Mexico / Highveld hotspots (wb42)
export ATM_RH_OCEAN_SST=0.007     # initial ocean surface RH follows the SST: ATM_RH_OCEAN at >= 29.5 C, lower by 0.007 per K below (tropical-ocean rain median 4.3 -> 2.7, NASA 2.5; wb43)
export ATM_RH_OCEAN_SST_MAX=0.014 # ... largest reduction
export ATM_RH_OCEAN_SST_COLD=25.5 # ... no reduction at and below 25.5 C, full from 26.5 C -- ONLY with this cut-off (without it water below 26 C stops raining, rainless 38 %, wb41)
# --- wb49 stack (user, 2026-10-06: "stay with wb47b, adopt and push when the 600 holds"): verified at 600 from scratch (run_wb49.sh): 968.7 mm/a (-1.0 %),
# r .609, sigma 1.23, bands 1762/502/1034/220, land/ocean 648/1096, land 0-15 / 15-35 / 35-65 1663 / 217 / 664 (NASA 1653 / 643 / 643), no cell > 11 mm/d,
# no drift (971.4 -> 968.7 over 100-600). Changed above: ATM_RH_LAND_EAST 1.35 -> 1.6, ATM_RH_LAND_EAST_MAX=0.010 added (46 knobs).
# COST, ACCEPTED: land 15-35 217 against the LAND-POLAR criterion > 320 -- FAILED; the 319 of wb45 rested on overshoot cells (16 % of the area, 87 % of the rain).
# --- wb57 stack (user, 2026-10-06: "1.08, combine with the evaporation knobs into one 600 ... adopt and push when wb57 holds"): verified at 600 from
# scratch (run_wb57.sh): 975.0 mm/a (-0.3 %), r .607, sigma 1.23, bands 1766/504/1035/261, land/ocean 648/1104, land 0-15 / 15-35 / 35-65 1663 / 217 / 664,
# ocean 65-90 268 (NASA 428: Arctic 328 / 379, Southern 184 / 490), E 758.6 mm/a, P/E 1.29 (was 537.5 / 1.80), no cell > 11 mm/d, no drift
# (975.8 -> 975.0 over 100-600). 49 knobs. Rain equatorward of 65 deg is the wb49 stack's to 0.3 %.
export ATM_EVAP_WIND=1            # bulk evaporation uses the wind speed |V| (shipped: sqrt((u2+v2+w2)/3) = |V|/sqrt(3)): E 539 -> 706 mm/a, rain unchanged (wb53a)
export ATM_EVAP_GUST=5            # (3 -> 5 with the wb72 stack: gust 3 left the formula wind at 3.5 m/s at 25-35 deg; ocean E 1060 -> 1182, P/E 1.04; 6 overshoots, P/E 0.96, wb69c) gustiness in quadrature (the annual-mean vector wind is 1.6 m/s at 25-35 deg, where Earth evaporates most): E 706 -> 776 at 60, 759 at 600 (wb53b, wb54); land E is still 0
# ATM_RH_STORM_POLAR: OFF again since the wb74 stack (was 1.08 from wb57: the polar floor lifted by latitude alone and put the Arctic at 74-86N 1.2-1.5x over NASA; the sea-temperature term below does its work). History: Arctic ocean 215 -> 328 mm/a (NASA 379) at 1.08, 1.12 overshot by 38 % (wb56)
# --- wb59 stack (user, 2026-10-06: "run the 600, adopt and push when it holds"): verified at 600 from scratch (run_wb59.sh): 975.5 mm/a (-0.3 %), r .607,
# sigma 1.23, bands 1766.5/504.6/1035.9/261.4, land/ocean 649.7/1104.5, E 850.8 mm/a (ocean 1062, land 325), P/E 1.15 (wb57: 758.6 / 1.29), no drift (975.9 -> 975.5
# over 100-600). 50 knobs. Rain is the wb57 stack's to 0.1 %.
export ATM_LAND_EVAP=1            # land evaporation from the Budyko curve on the model's own rain (E <= P, E <= E_pot): land E 0 -> 325 mm/a, E/P 0.50 (Earth ~0.62); NOT the land bucket, which is filled from the observed rain and gave land E 728 against P 653 (wb53c, wb58)
# --- wb63 stack (user, 2026-10-06: "b, run the 600, adopt and push when it holds"): verified at 600 from scratch (run_wb63.sh): 967.6 mm/a (-1.1 %),
# r .628, sigma 1.18, bands 1769/564/955/262, land/ocean 642.3/1096.4, ocean 15-35 / 35-65 693 / 1081 (NASA 809 / 1107), land 15-35 / 35-65 240 / 619,
# E 850 mm/a, P/E 1.14, no drift (967.8 -> 967.6 over 100-600). 51 knobs. Changed above: ATM_RH_STORM 1.15 -> 1.13. Best pattern scores of any verified
# stack (wb59: r .607, sigma 1.23). COST: E Australia 2.71 -> 3.20 mm/d (NASA 1.86).
export ATM_RH_STORM_WIDTH=17      # Gaussian width of the storm-track factor (shipped 15 deg): a lower, wider factor makes the ocean storm track flat from 38 to 62 deg as observed (southern rows 1080-1260 mm/a against NASA 1033-1162; was 950 -> 1540); moving the centre instead floods 34-46 deg (wb61), lowering the peak alone loses the band mean (wb60)
# --- wb66 stack (user, 2026-10-06: "a, run the 600, adopt and push when it holds"): verified at 600 from scratch (run_wb66.sh): 970.1 mm/a (-0.8 %),
# r .631, sigma 1.16, bands 1769/564/946/316, land/ocean 642.6/1099.7, ocean 35-65 / 65-90 1070 / 364 (NASA 1107 / 428; Arctic 405 / 379, Southern 307 / 490),
# northern ocean rows 54-58 / 58-62 1301 / 1326 (NASA 1100 / 1048; were 1590 / 1531), E 849 mm/a, P/E 1.14, E Australia 3.20, no drift (970.3 -> 970.1).
# 54 knobs. Rain equatorward of 50 deg, land and the tropics are the wb63 stack's.
export ATM_RH_STORM_SST=0.007     # (0.005 -> 0.007 with the wb74 stack) high-latitude ocean: initial RH lowered by 0.7 % per K of sea temperature above the reference, raised per K below -- the model's rain there followed the sea temperature (50-66 deg, model / NASA: -6..-2 C 0.65 S / 0.47 N, 9..14 C 1.57 / 1.12 on wb72) and NASA's does not (nrows.py, stormfit.py, wb64, wb65, wb73); 0.009 with 0.10 overshoots row 62-66S (1.27x, wb73a)
export ATM_RH_STORM_SST_MAX=0.08  # (0.04 -> 0.08 with the wb74 stack: the cap stopped the cold-water lift at -4 C; Southern Ocean 66-74S 0.55-0.58x NASA) largest relative change, either sign
export ATM_RH_STORM_SST_REF=3     # (shipped 4) reference sea temperature, deg C; 2 dries the North Atlantic drift too far (9-14 C north 914 / 1314, r .649, wb73c)
export ATM_RH_STORM_SST_LAT=48    # ... starts at 48 deg, full from 58 -- started at 40 deg it takes 20-40 % off rows that were on NASA (wb64)
# --- wb68 stack (user, 2026-10-07: "adopt wb68 and push"): verified at 600 from scratch (run_wb68.sh): 1016.9 mm/a (+4.0 %), r .648, sigma 1.14,
# bands 1769/649/1006/316, land/ocean 643.9/1164.6, ocean 15-35 / 35-65 810 / 1152 (NASA 809 / 1107), southern ocean rows 30-34 / 34-38 / 38-42
# 827 / 1064 / 1180 (NASA 950 / 1001 / 1077; were 462 / 564 / 1074), E 849 mm/a, P/E 1.20, E Australia 3.26, no drift (1017.3 -> 1016.9). 56 knobs.
# Best pattern scores of any verified stack (wb66: r .631, sigma 1.16). COST: global mean -0.8 -> +4.0 %, P/E 1.14 -> 1.20, row 38-42S 1.00 -> 1.10x NASA.
# Land, the tropics, the 65-90 band and rows poleward of 42 deg are the wb66 stack's.
export ATM_RH_OCEAN_ML_LAT0=22    # the ATM_RH_OCEAN_ML weight starts at 22 deg (shipped 30): ocean rows 22-38 deg rained at half of NASA because 19-26 % of the rain made at ~2.2 km reached the sea (row36.py); now 23 / 43 / 61 % at 28 / 32 / 36S. Started at 18 deg the 22-26N row is 1.35x NASA and convection there +41 % (wb67c)
export ATM_RH_OCEAN_ML_LAT1=38    # ... and is full at 38 deg (shipped 40)
# --- wb72 stack (user, 2026-10-08: "run wb71, then the 600, adopt and push when it holds"): verified at 600 from scratch (run_wb72.sh): 984.9 mm/a (+0.7 %),
# r .650, sigma 1.09, bands 1676/612/1013/322, land/ocean 649.1/1117.9, ocean 0-15 / 15-35 1676 / 759 (NASA 1440 / 809), land 35-65 / 65-90 638 / 259
# (NASA 643 / 295), N polar land 329 (NASA 418; was 243), Antarctica 207 (204; was 282), E 946.8 mm/a (ocean 1182, land 364), P/E 1.04, no cell > 11 mm/d,
# no drift (984.2 -> 984.9 over 100-600). 60 knobs. Changed above: ATM_EVAP_GUST 3 -> 5. Closes RC-RESID (global mean, P/E, polar land).
# COST: ocean 15-35 810 -> 759 (NASA 809; half of that band's rain is convective), N Europe 745 -> 1112 (877), Canada 276 -> 386 (308).
export ATM_MC_CMB_OCEAN=0.85      # ocean: factor on the cloud-base mass-flux coefficient, before the ceiling ATM_MC_MB_SAT_OCEAN: global +4.0 -> +0.3 %, ocean 0-15 1796 -> 1666 (NASA 1440), p99 8.2 (8.4); 0.80 takes ocean 15-35 to 734 (wb69)
export ATM_HCRIT_SFC_POLAR=1      # land poleward of 55..65 deg: cloud threshold at p x (the column's sea-level pressure) / (ground pressure) -- high ground carried cloud AT the ground (land poleward of 60 deg above 1000 m: N 1174 / 452, Greenland 661 / 392 mm/a) -- ONLY with the mixed layer below (alone it removes the high-latitude land rain)
export ATM_RH_LAND_ML=1500        # land poleward of 55..65 deg: initial boundary layer partly mixed up to 1500 m above the ground, the land twin of ATM_RH_OCEAN_ML: lowland snow reaches the ground (N land below 200 m 106 -> 442, NASA 555; W Siberia 62 -> 351) -- ONLY with the threshold above (alone: N land at 1-2 km 2277 mm/a, r .622, wb70c)
export ATM_RH_LAND_ML_STRENGTH=0.45  # partial mixing: 0.25 too dry (N lowland 209), 0.5 overshoots N Europe (1276 / 877), Canada and E Siberia (wb70, wb71); started at 50 deg it floods the 55-65N lowland (wb71c)
